{
  "connection": {
    "environment": "production",
    "host": "dev-db.local",
    "port": 5432,
    "database": "devops_dev",
    "username": "dev_user",
    "ssl_mode": "disable",
    "pool_size": 10,
    "timeout": 60
  },
  "backup": {
    "enabled": false,
    "schedule": "0 4 * * *",
    "retention_days": 7,
    "location": "./backups/dev"
  },
  "replication": {
    "enabled": false,
    "replicas": 0,
    "sync_mode": "asynchronous"
  }
}
